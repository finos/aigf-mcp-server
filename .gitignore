# ===============================================================================
# SMART GITIGNORE - FIXED VALUES ONLY
# ===============================================================================
# This file uses explicit file names instead of broad patterns.
# Only protects actual sensitive files and build artifacts.
# ===============================================================================

# ===============================================================================
# 1. SENSITIVE FILES (EXACT NAMES ONLY)
# ===============================================================================

# Environment files
.env
.env.local
.env.production
.env.staging
.env.development

# Secret files
secrets.json
api-keys.txt
passwords.txt
credentials.json
auth-tokens.txt

# Personal configuration
.dev-secrets
.personal-config
personal-notes.md
todo-personal.md

# Claude AI agent configuration
.claude/

# ===============================================================================
# 2. IDE PERSONAL SETTINGS (SPECIFIC FILES ONLY)
# ===============================================================================

# VS Code personal settings (not workspace settings)
.vscode/settings.personal.json
.vscode/launch.personal.json

# JetBrains personal files
.idea/workspace.personal.xml
.idea/misc.personal.xml

# ===============================================================================
# 3. STANDARD BUILD ARTIFACTS AND TEMP FILES
# ===============================================================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
.venv-semgrep/
env/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# MyPy and Ruff cache
.mypy_cache/
.ruff_cache/

# ===============================================================================
# 4. OPERATING SYSTEM FILES
# ===============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ===============================================================================
# 5. DEVELOPMENT AND CODING SESSION FILES
# ===============================================================================

# Private development files that should not be public (specific names only).
# macOS matches without regard to case, so DEVELOPMENT.md also hid
# docs/development.md there. Documents under docs/ are published.
CLAUDE.md
PERFORMANCE_SETUP.md
DEVELOPMENT.md
ARCHITECTURE.md
!/docs/**/PERFORMANCE_SETUP.md
!/docs/**/DEVELOPMENT.md
!/docs/**/ARCHITECTURE.md
.cache/
.framework_cache/
skills/
.playwright-mcp/
security-reports/
coverage-reports/
coverage.json

# Local e2e run artifacts written next to the script that produces them
scripts/e2e_report_*.md

# Specific development/testing files (not wildcards to avoid catching legitimate files)
mcp-cli-config.json
mcp-config.json
mcp-test-config.json
mcp_demo_config.json
mcp_client_demo.py
mcp_server_entry.py
test_mcp_client.py
show_frameworks.py

# Specific test script files
scripts/test-mcp-cli.sh
scripts/test-mcp-inspector-cli.sh

# Temporary sensitive files
temp-api-key.txt
debug-tokens.log
.auth-cache
security-scan-temp.json
audit-temp.log

# Log files
*.log
debug.log
error.log

# Backup files
*.bak
*.backup
*.old
*.orig

# ===============================================================================
# END SMART GITIGNORE
# ===============================================================================

# Generated by setuptools-scm at build time (pyproject.toml write_to); never source
src/finos_mcp/_version.py
