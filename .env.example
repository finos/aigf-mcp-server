# FINOS MCP Server Configuration
# Copy this file to .env and modify values as needed. The server reads it only
# when FINOS_MCP_ENV_FILE names it (an absolute path), never by its location.

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DEBUG: Detailed information, typically of interest only when diagnosing problems
# INFO: Confirmation that things are working as expected (default)
# WARNING: An indication that something unexpected happened
# ERROR: Due to a more serious problem, the software has not been able to perform some function
# CRITICAL: A serious error occurred
FINOS_MCP_LOG_LEVEL=INFO

# Enable debug mode with additional logging and error details
# Set to true for development, false for production
FINOS_MCP_DEBUG_MODE=false

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# HTTP client deadline in seconds
# How long one request to the FINOS repository may take in all, retries and
# body included
FINOS_MCP_HTTP_TIMEOUT=30

# Base URL for FINOS AI Governance Framework repository
# Default points to the main branch on GitHub
# You can override this to use a fork, a different branch, or a mirror.
# Documents are fetched over HTTPS only, and never from localhost or from a
# loopback or private address written as a number; such a base URL, or one
# with a query or fragment, is refused at startup with the reason. A mirror
# must be reachable as https on a public address.
FINOS_MCP_BASE_URL=https://raw.githubusercontent.com/finos/ai-governance-framework/main/docs

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================

# Enable in-memory caching of fetched documents
# Improves performance by avoiding repeated HTTP requests
# Set to false to disable caching (useful for development/testing)
FINOS_MCP_ENABLE_CACHE=true

# Maximum number of documents to cache in memory
# Higher values use more memory but provide better performance
# Adjust based on your memory constraints and usage patterns
FINOS_MCP_CACHE_MAX_SIZE=1000

# Default time-to-live for cached documents in seconds (1 hour)
# Documents older than this will be automatically expired and refetched
# Set to 0 for no expiration (cache indefinitely)
FINOS_MCP_CACHE_TTL_SECONDS=3600

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# MCP server name identifier
# Used in MCP protocol communications
FINOS_MCP_SERVER_NAME=finos-ai-governance

# MCP transport mode: stdio, http, streamable-http, sse
# stdio is recommended for local MCP clients (Claude Desktop/Cursor/VS Code)
FINOS_MCP_MCP_TRANSPORT=stdio

# Host/port used only for http/sse/streamable-http transports
# Loopback default prevents accidental external exposure
FINOS_MCP_MCP_HOST=127.0.0.1
FINOS_MCP_MCP_PORT=8000

# Seconds between the requests a networked server sends to the content host
# (FINOS_MCP_BASE_URL) to decide what GET /readyz answers. /readyz answers 503
# until the first request has finished and while the last one got no answer, a
# 429 or a 5xx (after an answered request, one without an answer is repeated
# once, 2 seconds later, before it counts). It also answers 503 for 60 seconds
# after repeated failed document fetches, whatever this interval is.
# GET /healthz answers 200 regardless. Neither needs a token.
# Range 5-3600. Not used by stdio, which serves no HTTP.
# FINOS_MCP_READINESS_PROBE_INTERVAL_SECONDS=30

# =============================================================================
# MCP AUTHENTICATION (REQUIRED FOR NON-STDIO TRANSPORTS)
# =============================================================================

# Enable JWT authentication at MCP boundary
# false: no boundary auth - only valid with FINOS_MCP_MCP_TRANSPORT=stdio
# true: require valid Bearer token for MCP requests
#
# Startup FAILS if a networked transport (http/streamable-http/sse) is selected
# while this is false. That combination would serve every tool and prompt to
# anyone who can reach the port.
FINOS_MCP_MCP_AUTH_ENABLED=false

# Development-only override for the rule above: run a networked transport with
# no authentication. Logs an error on every startup. Never set this where
# anything other than your own machine can reach the port.
# FINOS_MCP_ALLOW_INSECURE_HTTP=false

# JWT issuer (iss claim) expected in access tokens
# Required when FINOS_MCP_MCP_AUTH_ENABLED=true
# FINOS_MCP_MCP_AUTH_ISSUER=https://auth.example.com

# JWT audience (aud claim) expected in access tokens
# Required when FINOS_MCP_MCP_AUTH_ENABLED=true
# FINOS_MCP_MCP_AUTH_AUDIENCE=finos-mcp-server

# One verifier source is required when auth is enabled:
# Option A (recommended): JWKS URL for key rotation support
# FINOS_MCP_MCP_AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json

# The JWKS URI is fetched by this process at the first token verification, then
# for an unknown key id or a set older than an hour, at most once a minute; the
# document it returns decides which signatures are trusted. By default that
# fetch is SSRF-protected: HTTPS only, public unicast addresses only, DNS pinned
# against rebinding. Setting this to true removes all of it.
#
# Set it only when the identity provider is genuinely an internal service (for
# example Keycloak or Dex on a private network). Be aware that it also permits
# plain HTTP, where anyone on the network path can substitute the signing keys
# and mint tokens this server will accept. Every startup logs an error naming
# the URI while it is on.
#
# Startup fails if this is false and the JWKS URI can never be fetched under
# SSRF protection (not HTTPS, or a literal loopback/link-local/private address),
# rather than rejecting every token at runtime with an unexplained 401.
# FINOS_MCP_ALLOW_INSECURE_JWKS_URI=false

# Public URL clients use to reach this server. When set on a networked
# transport with auth enabled, a request without a valid token is answered with
# the address of a metadata document, served under
# /.well-known/oauth-protected-resource/, that names FINOS_MCP_MCP_AUTH_ISSUER
# as the place to sign in (RFC 9728). The issuer must then be an HTTP or HTTPS
# URL. Leave unset to publish nothing; tokens are checked the same either way.
# FINOS_MCP_MCP_AUTH_BASE_URL=https://mcp.example.com

# Option B: Static PEM public key (RSA; tokens must be signed with RS256)
# Do not set both JWKS and PUBLIC_KEY at the same time.
# FINOS_MCP_MCP_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Optional comma-separated required scopes
# FINOS_MCP_MCP_AUTH_REQUIRED_SCOPES=governance:read,governance:write

# =============================================================================
# DOS PROTECTION
# =============================================================================

# Per-client limits. "Client" means the JWT subject when auth is enabled,
# otherwise the caller's network address (see trusted proxies below). Under
# stdio there is one client per process, so these are effectively process-wide.
#
# Both limits count every client request, not just tool calls: resource reads,
# prompt fetches and the listing calls a session makes when it connects all
# spend from the same budget. Leave headroom for that handshake.
# FINOS_MCP_DOS_MAX_REQUESTS_PER_MINUTE=600
# FINOS_MCP_DOS_MAX_CONCURRENT_REQUESTS=10

# Comma-separated CIDRs of reverse proxies you operate.
#
# Leave this unset unless the server sits behind a proxy. Unset means
# X-Forwarded-For is ignored entirely and clients are identified by the address
# that opened the connection - correct for direct deployments.
#
# When set, the header is read ONLY from a peer inside one of these ranges.
# That gate matters: X-Forwarded-For is caller-controlled, so trusting it from
# an arbitrary peer would let any client mint a fresh rate-limit bucket per
# request by rotating the header.
#
# List EVERY hop you operate, not just the internet-facing one. With
# "client -> nginx(10.0.0.7) -> this server(127.0.0.1)", 10.0.0.0/8 must appear
# alongside 127.0.0.1/32 or the resolved client will be the nginx address.
#
# Startup fails on a malformed entry, or on 0.0.0.0/0/::/0 (trusting every
# address is strictly worse than leaving this unset).
#
# Typical single reverse proxy on the same host:
# FINOS_MCP_DOS_TRUSTED_PROXIES=127.0.0.1/32

# =============================================================================
# DEVELOPMENT EXAMPLES
# =============================================================================

# Example: Use a specific branch or fork
# FINOS_MCP_BASE_URL=https://raw.githubusercontent.com/your-fork/ai-governance-framework/feature-branch/docs

# =============================================================================
# GITHUB API CONFIGURATION (Optional but recommended)
# =============================================================================

# GitHub Personal Access Token for increased API rate limits and reliability
#
# Rate Limits:
#   Without token: 60 requests/hour per IP (shared across all local users)
#   With token: 5000 requests/hour per authenticated user (dedicated limit)
#
# Security Setup:
#   1. Visit: https://github.com/settings/tokens
#   2. Click "Generate new token" → "Generate new token (classic)"
#   3. Set expiration (recommend 90 days for security)
#   4. Select scopes: ONLY "public_repo" (read access to public repositories)
#   5. Never select private repository access or administrative scopes
#   6. Store token securely and never commit to version control
#
# Token Security Best Practices:
#   - Use minimal required permissions (public_repo only)
#   - Set reasonable expiration dates
#   - Rotate tokens regularly
#   - Monitor GitHub token usage in Settings > Developer settings > Personal access tokens
#   - Revoke immediately if compromised
#
# FINOS_MCP_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # pragma: allowlist secret

# =============================================================================
# ADVANCED / PRODUCTION CONFIGURATION
# =============================================================================

# Absolute path for the GitHub discovery cache directory.
# When unset, defaults to finos-mcp/discovery under XDG_CACHE_HOME, or
# ~/.cache. The directory is created for this user only (0700) and is not
# used when it is owned by someone else or writable by others; the listing is
# then kept in memory.
# FINOS_MCP_DISCOVERY_CACHE_DIR=/var/cache/finos-mcp/discovery

# =============================================================================
# CONFIGURATION EXAMPLES
# =============================================================================

# Example: Development settings with detailed logging
# FINOS_MCP_LOG_LEVEL=DEBUG
# FINOS_MCP_DEBUG_MODE=true
# FINOS_MCP_ENABLE_CACHE=false
# FINOS_MCP_HTTP_TIMEOUT=10

# Example: Production settings with optimized performance
# FINOS_MCP_LOG_LEVEL=WARNING
# FINOS_MCP_DEBUG_MODE=false
# FINOS_MCP_ENABLE_CACHE=true
# FINOS_MCP_CACHE_MAX_SIZE=5000
# FINOS_MCP_HTTP_TIMEOUT=60
